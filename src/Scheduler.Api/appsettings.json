      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": { "IncludeScopes": true, "UseUtcTimestamp": true }
    }
  },
  "AllowedHosts": "*"
}
